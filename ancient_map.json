      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "line-color": "rgba(96, 110, 64, 0.6)",
        "line-width": 1,
        "line-dasharray": [
          2,
          2.5
        ]
      }
    },
    {
      "id": "landcover_ice",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "==",
        [
          "get",
          "class"
