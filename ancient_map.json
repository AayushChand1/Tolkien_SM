{
  "version": 8,
  "name": "Ancient_Map",
  "id": "ancient-map",
  "metadata": {
    "description": "Static, hand-drawn parchment look. Forests/farmland/wetland/rock/residential are drawn patterns; mountains, temples, castles etc. are ink icons. Major roads only, English labels only."
  },
  "sources": {
    "ne2_shaded": {
      "maxzoom": 6,
      "tileSize": 256,
      "tiles": [
        "https://tiles.openfreemap.org/natural_earth/ne2sr/{z}/{x}/{y}.png"
      ],
      "type": "raster"
    },
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "sprite": "https://aayushchand1.github.io/Tolkien_SM/sprite/ancient_map_sprite",
  "glyphs": "https://aayushchand1.github.io/Tolkien_SM/glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "rgba(238, 222, 180, 1)",
        "background-pattern": "parchment_texture"
      }
    },
    {
      "id": "natural_earth",
      "type": "raster",
      "source": "ne2_shaded",
      "maxzoom": 7,
      "paint": {
        "raster-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          0.45,
          5,
          0.35,
          7,
          0
        ],
        "raster-saturation": -0.85,
        "raster-hue-rotate": 30,
        "raster-contrast": -0.1,
        "raster-brightness-max": 0.9
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "rgba(150, 160, 110, 0.14)",
        "fill-antialias": false
      }
    },
    {
